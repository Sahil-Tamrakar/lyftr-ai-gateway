# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Ordered, comma-separated provider keys. They become key_1, key_2, key_3 ...
# Never committed and never echoed by the API.
LLM_API_KEYS=your-first-key,your-second-key,your-third-key

# Any LiteLLM model identifier.
LLM_MODEL=gemini/gemini-2.0-flash

# Four slashes = absolute path. The /data directory is a named volume in Docker.
DATABASE_URL=sqlite:////data/app.db

# Strict CORS allow-list, comma-separated origins.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables the X-Simulate-Failure test hook.
ENABLE_FAILURE_SIMULATION=true

# LiteLLM built-in cache (local = in-memory).
CACHE_ENABLED=true
LITELLM_CACHE_TYPE=local

LLM_REQUEST_TIMEOUT=60

# ---------------------------------------------------------------------------
# Frontend (baked into the Vite build)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
